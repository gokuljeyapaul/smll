{
  "name": "postclip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/fetch_ocr_assets.mjs && node scripts/build_pwa_precache.mjs",
    "build:test": "POSTCLIP_TEST_BUILD=1 npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "fetch:model": "node scripts/fetch_model.mjs",
    "demo": "node scripts/run_demo.mjs",
    "bench:ocr": "node eval/run_ocr_bench.mjs",
    "generate:fixtures": "node fixtures/generate.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "onnxruntime-web": "1.31.1",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "tesseract.js": false,
    "protobufjs": false
  }
}
